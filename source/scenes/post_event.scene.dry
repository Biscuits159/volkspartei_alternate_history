        Q.old_middle_ddp -= 6/12;
        Q.rural_dbp += 1/12;
        Q.workers_z += 2/12;
        Q.old_middle_z += 2/12;
        Q.new_middle_z += 2/12;
        Q.rural_z += 2/12;
        Q.catholics_z += 2/12;
        Q.workers_csvd += 2/12;
        Q.new_middle_csvd += 2/12;
