        Q.rural_dnvp -= 2/12;
        Q.new_middle_nsdap += 6/12;
        Q.old_middle_nsdap += 6/12;
        Q.catholics_nsdap += 1/12;
        Q.unemployed_nsdap += 6/12;
        Q.rural_nsdap += 8/12;
        Q.new_middle_other -= 2/12;
        Q.old_middle_other -= 2/12;
        Q.rural_other -= 1/12;
        Q.catholics_other -= 3/12;
        if (!Q.works_program) { 
            Q.inflation -= 2/12;
            if (Q.month < 7) Q.unemployed += 2/12; 
            if (Q.month >= 7) Q.unemployed += 3/12; 
            Q.workers_kpd += 3/12;
            Q.workers_spd -= 3/12;
            Q.workers_nsdap += 4/12;
            Q.new_middle_nsdap += 4/12;
            Q.old_middle_nsdap += 4/12;
            Q.rural_nsdap += 3/12;
            Q.catholics_nsdap += 1/12;
            Q.sh_militancy += 0.05/12;
            Q.sa_militancy += 0.15/12;
            if (Q.dnf_formed) {
                Q.rural_dnf += 3/12;
                Q.old_middle_dnf += 4/12;
                Q.new_middle_dnf += 2/12;
            } if (Q.kvp_formed) {
                Q.rural_kvp -= 3/12;
                Q.rural_dnvp += 3/12;
                Q.old_middle_kvp -= 3/12;
                Q.old_middle_dnvp += 3/12;
            }
        }
        Q.rfb_strength += (25*(100 - Q.pro_republic) / 100) /12;
        if (Q.rfb_banned) Q.rfb_strength -= (25*(100 - Q.pro_republic) / 100) /12;
        Q.sh_strength += (75*(100 - Q.pro_republic) / 100) /12;
        if (Q.sh_banned) Q.sh_strength -= (25*(100 - Q.pro_republic) / 100) /12;
        Q.sa_strength += (75*(100 - Q.pro_republic) / 100) /12;
        if (Q.sa_banned) Q.sa_strength -= (50*(100 - Q.pro_republic) / 100) /12;
    } else if (Q.year == 1931) {
        Q.unemployed += 5/12;
        Q.inflation -= 4/12;
        if (Q.works_program) {
            Q.unemployed -= 6/12;
            Q.inflation += 5/12;
            if (Q.works_program > 1) {
                Q.unemployed -= 3/12;
                Q.inflation += 2/12;
            }
        }
        Q.workers_spd += 7/12;
        Q.new_middle_spd += 4/12;
        Q.old_middle_ddp -= 1/12;
        Q.new_middle_ddp -= 1/12;
        Q.rural_dbp -= 3/12;
        Q.workers_z += 1/12;
        Q.old_middle_z += 1/12;
        Q.new_middle_z += 1/12;
        Q.rural_z += 1/12;
        if (Q.z_leader == "Kaas") {
            Q.catholics_z += 3/12;
        }
        if (Q.dvp_leader == "Curtius" || lvp_formed || nfvp_formed) {
            Q.rural_dvp -= 2/12;
        } else {
            Q.rural_dvp -= 4/12;
        }
        Q.rural_dvp -= 8/12;
        Q.catholics_dvp -= 2/12;
        Q.rural_cnblp -= 2/12;
        Q.catholics_kvp -= 2/12;
        Q.new_middle_nsdap += 4/12;
        Q.old_middle_nsdap += 6/12;
        Q.rural_nsdap += 6/12;
        if (Q.chancellor == "Brüning") {
            Q.old_middle_ddp -= 3/12;
            Q.new_middle_ddp -= 3/12;
            Q.old_middle_dvp -= 3/12;
            Q.new_middle_dvp -= 3/12;
            if (Q.reparations > -2) {
                Q.unemployed += 3/12;
                Q.inflation -= 2/12;
            } else if (Q.reparations <= -2) {
                Q.unemployed += 1.5/12;
                Q.inflation -= 1/12;
            }
        }
        // TODO: economic policies should reduce NSDAP rurals
        if (!Q.works_program) {
            Q.workers -= 4/12;
            Q.workers_kpd += 2/12;
            Q.unemployed_kpd += 2/12;
            Q.new_middle_ddp -= 2/12;
            Q.old_middle_ddp -= 2/12;
            Q.rural_ddp -= 2/12;
            Q.new_middle_dvp -= 5/12;
            Q.old_middle_dvp -= 5/12;
            Q.rural_dvp -= 4/12;
            Q.rural_cnblp -= 6/12;
            Q.workers_nsdap += 2/12;
            Q.new_middle_nsdap += 4/12;
            Q.old_middle_nsdap += 4/12;
            Q.rural_nsdap += 2/12;
            Q.catholics_nsdap += 2/12;
            Q.unemployed_nsdap += 6/12;
            Q.workers_other -= 4/12;
            Q.rural_other -= 2/12;
            Q.catholics_other -= 2/12;
            Q.unemployed_other -= 3/12;
            if (Q.cvp_formed) {
                Q.workers_z -= 2/12;
                Q.new_middle_z -= 3/12;
                Q.old_middle_z -= 3/12;
                Q.rural_z -= 2/12;
                Q.catholics_z -= 2/12;
            }
            if (Q.chancellor == "Brüning") {
                Q.new_middle_other -= 2/12;
                Q.old_middle_other -= 2/12;
                Q.new_middle_nsdap += 2/12;
                Q.old_middle_nsdap += 2/12;
                if (Q.cvp_formed) {
                    Q.new_middle_z -= 3/12;
                    Q.old_middle_z -= 3/12;
                    Q.new_middle_nsdap += 3/12;
                    Q.old_middle_nsdap += 3/12;
                }
            }
            if (Q.kvp_formed) {
                Q.rural_kvp -= 3/12;
                Q.rural_dnvp += 3/12;
                Q.old_middle_kvp -= 3/12;
                Q.old_middle_dnvp += 3/12;
                Q.new_middle_kvp -= 3/12;
                Q.new_middle_dnvp += 3/12;
            }
            if (Q.dnf_formed) {
                Q.rural_dnf += 4/12;
                Q.old_middle_dnf += 4/12;
                Q.new_middle_dnf += 2/12;
            }
            Q.rfb_strength += (25*(100 - Q.pro_republic) / 100) /12;
            if (Q.rfb_banned) Q.rfb_strength -= (25*(100 - Q.pro_republic) / 100) /12;
            Q.rb_militancy += (Q.pro_republic / 2000) /12;
            Q.sh_strength += (50*(100 - Q.pro_republic) / 100) /12;
            if (Q.sh_banned) Q.sh_strength -= (25*(100 - Q.pro_republic) / 100) /12;
            Q.sh_militancy += 0.05/12;
            Q.sa_strength += (125*(100 - Q.pro_republic) / 100) /12;
            if (Q.sa_banned) Q.sa_strength -= (50*(100 - Q.pro_republic) / 100) /12;
            Q.sa_militancy += 0.15/12;
        } else if (Q.unemployed > 15) {
            Q.unemployed_kpd += 2/12;
            Q.new_middle_dvp -= 2/12;
            Q.old_middle_dvp -= 2/12;
            Q.rural_dvp -= 1/12;
            Q.new_middle_nsdap += 4/12;
            Q.old_middle_nsdap += 4/12;
            Q.rural_nsdap += 3/12;
            Q.unemployed_nsdap += 4/12;
            if (Q.dnf_formed) {
                Q.rural_dnf += 3/12;
                Q.old_middle_dnf += 4/12;
                Q.new_middle_dnf += 2/12;
            }
            Q.sa_militancy += 0.1/12;
        }
        Q.sh_strength += (50*(100 - Q.pro_republic) / 100) /12;
        if (Q.sh_banned) {
            Q.sh_strength -= (25*(100 - Q.pro_republic) / 100) /12;
        }
        Q.sa_strength += (100*(100 - Q.pro_republic) / 100) /12;
        if (Q.sa_banned) {
            Q.sa_strength -= (50*(100 - Q.pro_republic) / 100) /12;
        }
        Q.sa_militancy += 0.1/12;
    } else if (Q.year == 1932) {
        Q.workers_kpd += 2/12;
        Q.rural_dbp -= 4/12;
        Q.old_middle_wp -= 4/12;
        Q.rural_cnblp -= 3/12;
        if (Q.dnf_formed) {
            Q.workers_dnf += 1/12;
            Q.rural_dnf += 3/12;
            Q.old_middle_dnf += 3/12;
            Q.new_middle_dnf += 1/12;
        }
        Q.workers_nsdap += 2/12;
        Q.new_middle_nsdap += 3/12;
        Q.old_middle_nsdap += 3/12;
        Q.rural_nsdap += 3/12;
        Q.unemployed_nsdap += 3/12;
        Q.workers_other -= 2/12;
        Q.new_middle_other -= 3/12;
        Q.old_middle_other -= 3/12;
        Q.rural_other -= 3/12;
        if (Q.chancellor == "Brüning") {
            if (Q.reparations > -2) {
                Q.unemployed += 2/12;
                Q.inflation -= 1/12;
            } else if (Q.reparations <= -2) {
                Q.unemployed += 1/12;
                Q.inflation -= 0.5/12;
            }
        }
        if (!Q.works_program) {
            Q.unemployed += 3/12;
            Q.workers -= 4/12;
            Q.inflation -= 2/12;
            Q.economic_growth -= 1/12;
            Q.workers_kpd += 3/12;
            Q.unemployed_kpd += 2/12;
            if (Q.z_leader == "Kaas") {
                Q.catholics_z += 5/12;
            }
            Q.new_middle_dvp -= 2/12;
            Q.old_middle_dvp -= 2/12;
            Q.rural_dvp -= 2/12;
            Q.catholics_dvp -= 1/12;
            if (Q.cvp_formed) {
                Q.rural_z -= 2/12;
                Q.catholics_z -= 2/12;
                Q.rural_dnf += 2/12;
                Q.catholics_nsdap += 2/12;
            }
            if (Q.kvp_formed) {
                Q.rural_kvp -= 3/12;
                Q.rural_dnvp += 3/12;
                Q.old_middle_kvp -= 3/12;
                Q.old_middle_dnvp += 3/12;
                Q.new_middle_kvp -= 3/12;
                Q.new_middle_dnvp += 3/12;
            }
            Q.new_middle_dnvp += 4/12;
            Q.new_middle_dnvp += 4/12;
            Q.rural_dnvp -= 4/12;
            if (Q.dnf_formed) {
                Q.workers_dnf += 1/12;
                Q.rural_dnf += 4/12;
                Q.old_middle_dnf += 4/12;
                Q.new_middle_dnf += 2/12;
            }
            Q.workers_nsdap += 3/12;
            Q.new_middle_nsdap += 4/12;
            Q.old_middle_nsdap += 4/12;
            Q.rural_nsdap += 4/12;
            Q.catholics_nsdap += 2/12;
            Q.unemployed_nsdap += 4/12;
            Q.workers_other -= 3/12;
            Q.new_middle_other -= 2/12;
            Q.old_middle_other -= 2/12;
            Q.rural_other -= 2/12;
            Q.catholics_other -= 3/12;
            Q.unemployed_other -= 2/12;
            Q.rfb_strength += (25*(100 - Q.pro_republic) / 100) /12;
            if (Q.rfb_banned) Q.rfb_strength -= (25*(100 - Q.pro_republic) / 100) /12;
            Q.rb_militancy += (Q.pro_republic / 2000) /12;
            Q.sa_strength += (200*(100 - Q.pro_republic) / 100) /12;
            if (Q.sa_banned) Q.sa_strength -= (50*(100 - Q.pro_republic) / 100) /12;
            Q.sa_militancy += 0.1/12;
        } else if (Q.unemployed > 25) {
            if (Q.kvp_formed) {
                Q.rural_kvp -= 2/12;
                Q.rural_dnvp += 2/12;
                Q.new_middle_kvp -= 2/12;
                Q.new_middle_dnvp += 2/12;
            }
            if (Q.dnf_formed) {
                Q.workers_dnf += 2/12;
                Q.rural_dnf += 4/12;
                Q.old_middle_dnf += 4/12;
                Q.new_middle_dnf += 2/12;
            }
            Q.new_middle_nsdap += 4/12;
            Q.old_middle_nsdap += 4/12;
            Q.rural_nsdap += 4/12;
            Q.unemployed_nsdap += 5/12;
            Q.sa_strength += (125*(100 - Q.pro_republic) / 100) /12;
            if (Q.sa_banned) Q.sa_strength -= (50*(100 - Q.pro_republic) / 100) /12;
        } else if (Q.unemployed > 20) {
            if (Q.kvp_formed) {
                Q.rural_kvp -= 1/12;
                Q.rural_dnvp += 1/12;
                Q.new_middle_kvp -= 1/12;
                Q.new_middle_dnvp += 1/12;
            }
            if (Q.dnf_formed) {
                Q.workers_dnf += 1/12;
                Q.rural_dnf += 2/12;
                Q.old_middle_dnf += 2/12;
                Q.new_middle_dnf += 1/12;
            }
            Q.new_middle_nsdap += 2/12;
            Q.old_middle_nsdap += 3/12;
            Q.rural_nsdap += 2/12;
            Q.unemployed_nsdap += 3/12;
            Q.old_sa_strength = Q.sa_strength;
            Q.sa_strength += (75*(100 - Q.pro_republic) / 100) /12;
            if (Q.sa_banned) Q.sa_strength -= (50*(100 - Q.pro_republic) / 100) /12;
        }
        Q.sa_strength += (100*(100 - Q.pro_republic) / 100) /12;
        if (Q.sa_banned && Q.sa_strength > Q.old_sa_strength) Q.sa_strength -= (50*(100 - Q.pro_republic) / 100) /12;
    } else if (Q.year >= 1933) {
        if (Q.return_to_normalcy) {
            // return to normalcy -> voters return to the base
            if (Q.workers_spd_normalized < 75) Q.workers_spd += 16/12;
            if (Q.new_middle_spd_normalized < 10 && Q.spd_volkspartei) Q.new_middle_spd += 7/12;
            if (Q.rural_spd_normalized < 10 && Q.spd_volkspartei) Q.rural_spd += 7/12;
            if (Q.workers_aspd_normalized < 5) Q.workers_aspd += 6/12;
            if (Q.unemployed_aspd_normalized < 5) Q.unemployed_aspd += 4/12;
            if (Q.new_middle_ddp_normalized < 40) Q.new_middle_ddp += 8/12;
            if (Q.old_middle_ddp_normalized < 20) Q.old_middle_ddp += 6/12;
            if (Q.rural_dbp_normalized < 8) Q.rural_dbp += 6/12;
            if (Q.workers_csrp_normalized < 2) Q.workers_csrp += 4/12;
            if (Q.catholics_csrp_normalized < 7) Q.catholics_csrp += 6/12;
            if (Q.catholics_z_normalized < 50) Q.catholics_z += 8/12;
            if (Q.cvp_formed) {
                if (Q.workers_z_normalized < 15) Q.catholics_z += 6/12;
                if (Q.new_middle_z_normalized < 40) Q.new_middle_z += 6/12;
                if (Q.old_middle_z_normalized < 40) Q.old_middle_z += 8/12;
                if (Q.rural_z_normalized < 40) Q.rural_z += 8/12;
                if (Q.unemployed_z_normalized < 10) Q.unemployed_z += 4/12;
                if (Q.catholics_z_normalized < 30) Q.catholics_z += 4/12;                     
            }
            if (Q.workers_csvd_normalized < 5) Q.workers_csvd += 6/12;
            if (Q.new_middle_csvd_normalized < 8) Q.new_middle_csvd += 8/12;
            if (Q.old_middle_wp_normalized < 25) Q.old_middle_wp += 6/12;
            if (Q.new_middle_other_normalized < 5 && (Q.vnr_exist || Q.vrp_exist)) Q.new_middle_other += 6/12;
            if (Q.old_middle_other_normalized < 5 && (Q.vnr_exist || Q.vrp_exist)) Q.old_middle_other += 6/12;
            if (Q.rural_cnblp_normalized < 17) Q.rural_cnblp += 8/12;
            if (Q.kvp_formed) {
                if (Q.new_middle_kvp_normalized < 25) {
                    Q.new_middle_dnvp -= 4/12;
                    Q.new_middle_kvp += 4/12;
                }
                if (Q.rural_kvp_normalized < 30) {
                    Q.rural_dnvp -= 6/12;
                    Q.rural_kvp += 6/12;
                }
                if (Q.old_middle_kvp_normalized < 25) {
                    Q.old_middle_dnvp -= 4/12;
                    Q.old_middle_kvp += 4/12;
                }
                if (Q.workers_kvp_normalized < 5 && Q.csvd_kvp) {
                    Q.workers_dnvp -= 4/12;
                    Q.workers_kvp += 4/12;
                }
                if (Q.new_middle_kvp_normalized < 35 && Q.csvd_kvp) {
                    Q.new_middle_dnvp -= 4/12;
                    Q.new_middle_kvp += 4/12;
                }
                if (Q.old_middle_kvp_normalized < 35 && Q.wp_kvp) {
                    Q.old_middle_dnvp -= 6/12;
                    Q.old_middle_kvp += 6/12;
                }
                if (Q.rural_kvp_normalized < 55 && Q.cnblp_kvp) {
                    Q.rural_dnvp -= 6/12;
                    Q.rural_kvp += 6/12;
                }
            }
            if (Q.rural_dnvp_normalized < 40) Q.rural_dnvp += 6/12;
            if (Q.dnf_formed) {
                if (Q.new_middle_dnvp_normalized < 20) {
                    Q.new_middle_dnf -= 4/12;
                    Q.new_middle_dnvp += 4/12;
                }
                if (Q.rural_dnvp_normalized < 40) {
                    Q.rural_dnf -= 6/12;
                    Q.rural_dnvp += 6/12;
                }
                if (Q.old_middle_dnvp_normalized < 20) {
                    Q.old_middle_dnf -= 4/12;
                    Q.old_middle_dnvp += 4/12;
                }
                if (Q.old_middle_dnvp_normalized < 30 && Q.wp_dnvp) {
                    Q.old_middle_dnf -= 8/12;
                    Q.old_middle_dnvp += 8/12;
                }
                if (Q.rural_dnvp_normalized < 60 && Q.cnblp_dnvp) {
                    Q.rural_dnf -= 8/12;
                    Q.rural_dnvp += 8/12;
                }
            }
        }
        if (Q.unemployed >= 20) {
            Q.unemployed *= 0.99;
            Q.inflation += 3/12;
            Q.economic_growth += 2/12;
            if (Q.dvp_in_government) {
                Q.new_middle_dvp -= 3/12;
                Q.old_middle_dvp -= 3/12;
            }
            Q.rural_nsdap += 2/12;
            Q.unemployed_nsdap += 2/12;
            Q.old_middle_nsdap += 2/12;
            Q.new_middle_nsdap += 2/12;
        }
    }
    // prevent forever support if the economy is bad
    if (Q.year >= 1934) {
        if (Q.unemployed >= 15 && Q.year == 1934) {
            Q.unemployed *= 0.98;
            Q.inflation += 3/12;
            Q.economic_growth += 3/12;
        }
        if ((Q.inflation >= 8 || Q.unemployed >= 20) && Q.dvp_in_government) {
            if (Q.workers_dvp_normalized > 20) Q.workers_dvp -= 6/12;
            if (Q.unemployed_dvp_normalized > 20) Q.unemployed_dvp -= 6/12;
            if (Q.new_middle_dvp_normalized > 40) Q.new_middle_dvp -= 6/12;
            if (Q.old_middle_dvp_normalized > 40) Q.old_middle_dvp -= 6/12;
            if (Q.rural_dvp_normalized > 20) Q.rural_dvp -= 6/12;
            if (Q.catholics_dvp_normalized > 20) Q.catholics_dvp -= 6/12;
        }
    }

    if (Q.far_right_paramilitary && Q.year >= 1930 && !Q.return_to_normalcy) {
        Q.workers_nsdap += 4*Q.paramilitary_popularity_bonus/12;
        Q.workers_spd -= 4*Q.paramilitary_popularity_bonus/12;
        Q.new_middle_nsdap += 4*Q.paramilitary_popularity_bonus/12;
        Q.new_middle_ddp -= 4*Q.paramilitary_popularity_bonus/12;
        if (Q.nfvp_formed || Q.lvp_formed) Q.new_middle_dvp -= 4*Q.paramilitary_popularity_bonus/12;
        Q.old_middle_nsdap += 4*Q.paramilitary_popularity_bonus/12;
        if (!Q.dvp_in_stahlhelm) Q.old_middle_dvp -= 2*Q.paramilitary_popularity_bonus/12;
        Q.old_middle_wp -= 2*Q.paramilitary_popularity_bonus/12;
        Q.rural_nsdap += 2*Q.paramilitary_popularity_bonus/12;
        Q.rural_cnblp -= 2*Q.paramilitary_popularity_bonus/12;
        Q.unemployed_nsdap += 6*Q.paramilitary_popularity_bonus/12;
        Q.unemployed_kpd -= 6*Q.paramilitary_popularity_bonus/12;
        Q.catholics_nsdap += 2*Q.paramilitary_popularity_bonus/12;
        Q.catholics_z -= 2*Q.paramilitary_popularity_bonus/12;
        Q.pro_republic -= 0.3;
        Q.nationalism += 0.25;
        if (Q.sa_paramilitary) {
            Q.workers_nsdap += 1*Q.paramilitary_popularity_bonus/12;
            Q.unemployed_nsdap += 2*Q.paramilitary_popularity_bonus/12;
            Q.new_middle_nsdap += 1*Q.paramilitary_popularity_bonus/12;
            Q.old_middle_nsdap += 1*Q.paramilitary_popularity_bonus/12;
            Q.rural_nsdap += 1*Q.paramilitary_popularity_bonus/12;
            Q.catholics_nsdap += 1*Q.paramilitary_popularity_bonus/12;
            Q.pro_republic -= 0.25;
        }
    } else if (Q.pro_republic_paramilitary && Q.year >= 1930 && !Q.return_to_normalcy) {
        Q.workers_spd += 3*Q.paramilitary_popularity_bonus/12;
        Q.workers_nsdap -= 3*Q.paramilitary_popularity_bonus/12;
        Q.new_middle_nsdap -= 3*Q.paramilitary_popularity_bonus/12;
        Q.new_middle_spd += 2*Q.paramilitary_popularity_bonus/12;
        Q.new_middle_ddp += 1*Q.paramilitary_popularity_bonus/12;
        Q.old_middle_nsdap -= 1*Q.paramilitary_popularity_bonus/12;
        Q.old_middle_ddp += 1*Q.paramilitary_popularity_bonus/12;
        Q.rural_nsdap -= 1*Q.paramilitary_popularity_bonus/12;
        Q.unemployed_spd += 5*Q.paramilitary_popularity_bonus/12;
        Q.unemployed_nsdap -= 4*Q.paramilitary_popularity_bonus/12;
        Q.unemployed_kpd -= 1*Q.paramilitary_popularity_bonus/12;
        if (Q.catholics_nsdap >= 1) Q.catholics_nsdap -= 1*Q.paramilitary_popularity_bonus/12;
        if (Q.catholics_nsdap >= 1) Q.catholics_spd += 1*Q.paramilitary_popularity_bonus/12;
        if (Q.pro_republic < 50) Q.pro_republic += Q.paramilitary_popularity_bonus/20;
    } else if (Q.far_left_paramilitary && Q.year >= 1930 && !Q.return_to_normalcy) {
        Q.workers_kpd += 5*Q.paramilitary_popularity_bonus/12;
        Q.workers_nsdap -= 5*Q.paramilitary_popularity_bonus/12;
        Q.unemployed_kpd += 6*Q.paramilitary_popularity_bonus/12;
        Q.unemployed_nsdap -= 6*Q.paramilitary_popularity_bonus/12;
        Q.new_middle_kpd += 1*Q.paramilitary_popularity_bonus/12;
        Q.new_middle_nsdap -= 1*Q.paramilitary_popularity_bonus/12;
        Q.catholics_kpd += 1*Q.paramilitary_popularity_bonus/12;
        Q.catholics_nsdap -= 1*Q.paramilitary_popularity_bonus/12;
        Q.pro_republic -= 0.5;
        Q.socialism += 0.5;
    }

    if (Q.spd_wtb_plan_implemented && !Q.return_to_normalcy) {
        if (Q.unemployed >= 15) {
            Q.unemployed -= 10/12;
        } else if (Q.unemployed >= 5 && Q.unemployed < 15) {
            Q.unemployed -= 5/12;
        } else if (Q.unemployed >= 0 && Q.unemployed < 5) {
            Q.unemployed += 1/12;
        } else {
            Q.unemployed += 6/12;
        }

        Q.workers += 4/12;
        Q.inflation += 3/12;
        
        if (Q.unemployed < 5) Q.inflation += 1;
        Q.economic_growth += 2/12; 
        if (Q.economic_growth > 5) Q.economic_growth -= 1/12;

        Q.workers_spd += 18/12;
        Q.new_middle_spd += 6/12;
        Q.old_middle_spd += 6/12;
        Q.rural_spd += 6/12;
        Q.unemployed_spd += 12/12;
        Q.workers_kpd -= 6/12;
        Q.unemployed_kpd -= 6/12;
        Q.workers_nsdap -= 12/12;
        Q.unemployed_nsdap -= 6/12;
    }

    if (Q.spd_left_plan_implemented && !Q.return_to_normalcy) {
        if (Q.unemployed >= 15) {
            Q.unemployed -= 10/12;
        } else if (Q.unemployed >= 5 && Q.unemployed < 15) {
            Q.unemployed -= 5/12;
        } else if (Q.unemployed >= 0 && Q.unemployed < 5) {
            Q.unemployed += 1/12;
        } else {
            Q.unemployed += 6/12;
        }

        Q.workers += 8/12;
        Q.inflation += 2/12;

        if (Q.economic_growth < 5) Q.economic_growth += 1/12;

        Q.socialism += 6/12;

        Q.workers_spd += 24/12;
        Q.unemployed_spd += 18/12;
        Q.workers_kpd -= 12/12;
        Q.unemployed_kpd -= 6/12;
        Q.workers_nsdap -= 12/12;
        Q.unemployed_nsdap -= 12/12;
    }

    if (!Q.lvp_formed && !Q.nfvp_formed) {
        Q.nationalist_dissent *= 0.925
        Q.industrialist_dissent *= 0.925
        Q.liberal_dissent *= 0.925
        Q.labor_dissent *= 0.925
    }

    if (Q.pro_republic >= (Q.nsdap_votes + Q.dnvp_votes + Q.kpd_votes + Q.other_votes + 30)) Q.dvp_left += 0.1
    
    if (Q.liberal_strength > Q.nationalist_strength + (Q.industrialist_strength * 0.5)) {
        Q.dvp_left += 0.1
    } else {
        Q.dvp_left -= 0.1
    }
    
    if (!Q.no_stresemann) Q.dvp_left += 0.1

    if (Q.z_in_government && Q.z_leader == "Stegerwald" && Q.dnvp_in_government && Q.dnvp_leader == "Treviranus") {
        Q.cvp_merger_countdown -= 1;
    }

    if (Q.dvp_in_government) {
        Q.demand_for_action_countdown -= 1;
    }

    if (Q.demand_for_action_countdown < 0) {
        Q.new_middle_dvp *= 0.7;
        Q.old_middle_dvp *= 0.7;
        Q.nationalist_dissent += 10;
        Q.industrialist_dissent += 15;
        Q.labor_dissent += 15;
        Q.demand_for_action_countdown = 8;
    }
    
    if (Q.spd_toleration) Q.spd_patience -= (5 - Q.spd_relation/50);

    if (Q.president == "Hindenburg") {

        if (Q.spd_in_government) Q.hindenburg_angry += 4;
        if (Q.spd_toleration) Q.hindenburg_angry += 3;

        if (Q.dvp_left < 0) Q.hindenburg_angry += 1;

        if (Q.pro_republic - Q.nsdap_votes < 50) Q.hindenburg_angry += 1;
        if (Q.largest_party == "NSDAP" && Q.nsdap_r >= 26) Q.hindenburg_angry += 5;

        if (Q.dnvp_left >= 0) Q.hindenburg_angry -= 2;
        if (Q.kvp_formed) Q.hindenburg_angry -= 1;

        if (Q.black_thursday_seen && !Q.works_program) Q.hindenburg_angry += 1;
        if (Q.return_to_normalcy) Q.hindenburg_angry -= 3;
    
        if (Q.chancellor == "Brüning" && !Q.spd_in_government && Q.year >= 1930) {
            Q.bruning_chancellor_time += 1;
        
            if (Q.spd_toleration) {
                Q.bruning_toleration_time += 1; 
                Q.ddp_cohesion -= 0.25;
                if (Q.dvp_in_government) Q.nationalist_dissent += 0.5;
            } else if (!Q.spd_toleration) {
                Q.bruning_toleration_time = 0;
            }
        }
    }





    if (Q.month == 1) {
        Q.budget += 1
    }
}





Q.has_event = 0;
// check if there are any cards in #event, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
} else {
    has_event = 0;
}
// pre-load all of the event images
if (this.ui && this.ui.show_portraits) {
    for (var choice of choices) {
        var cc = this.game.scenes[choice.id];
        if (cc.faceImage) {
            var im = new Image();
            im.url = cc.faceImage;
        }
    }
}

if (typeof window !== "undefined" && window.generateBar) {
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0 and difficulty >= 0; main.main_easy if has_event = 0 and difficulty < 0

= [+ month : month +] [+ year +][? if weeks_enabled:, Week [+ week +]?]

@events_choice

- #event

# This scene is solely for updating numbers after events, and routing to special events.
