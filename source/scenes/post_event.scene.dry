            Q.old_middle_ddp -= 3/12;
            Q.workers_z += 9/12;
            Q.new_middle_z += 8/12;
            Q.old_middle_z += 5/12;
            Q.rural_z += 5/12;
            Q.catholics_z -= 4/12;
            Q.unemployed_z += 3/12;
            Q.new_middle_dvp -= 3/12;
            Q.old_middle_dvp -= 3/12;
            Q.rural_dvp -= 4/12;
            Q.rural_dnvp -= 6/12;
            Q.rural_dnf -= 2/12;
            Q.workers_other -= 2/12;
            Q.new_middle_other -= 5/12;
            Q.old_middle_other -= 5/12;
            Q.rural_other -= 3/12;
            Q.unemployed_other -= 3/12;
