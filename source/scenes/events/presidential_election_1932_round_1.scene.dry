@round2_convince_wp
view-if: wp_candidate != dvp_candidate and wp_exist and dvp_candidate != "Braun"
go-to: r2_wp_failed if (wp_relation >= 40 and wp_radical == 0); r2_wp_success if not (wp_relation >= 40 or wp_radical)
max-visits: 1

@r2_wp_success
on-arrival: wp_candidate = dvp_candidate; wp_relation += 3
go-to: round2_menu

