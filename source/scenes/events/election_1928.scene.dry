title: Reichstag Elections
new-page: true
tags: event
priority: -1
view-if: (year = next_election_year and month >= next_election_month and (week >= next_election_week or not weeks_enabled)) or (year > next_election_year)
on-departure: month_actions += 1; in_election = 0; next_election_year = next_election_year + 4; n_elections += 1; next_election_time = time + 48; 
set-jump: post_election_1928
face-image: img/Rothe_Wahlen_1903.jpg

# TODO: should there be an image?

# the low priority means that this event is only seen after all other events are resolved for the month.

= Elections, [+ month : month +] [+ year +]

The Reichstag elections are to be held now.

- @election_algorithm: May we do our best...
- @cancel_elections

@cancel_elections
title: We cannot hold the elections now. Cancel the elections.
subtitle: This is an anti-democratic move that may backfire.
view-if: in_emergency_government == 1 and president == "Braun" and not presidential_powers

Since we are currently ruling as part of an emergency government, we may use quasi-constitutional trickery to significantly delay these elections, and continue governing via Article 48. This is likely to be extremely unpopular both with our base and with the other parties. However, this may be necessary to prevent the extremists from gaining power.

- @cancel_elections_2: Yes, do it.
- @election_algorithm: No, let's hold the elections.

@cancel_elections_2
on-departure: next_election_year = next_election_year + 1; next_election_time = time + 12; pro_republic -= 10; spd_relation -= 8; z_relation -= 8; ddp_relation -= 10; kpd_relation -= 8; coup_progress += 2; workers_spd -= 4; new_middle_spd -= 5; old_middle_spd -= 5; rural_spd -= 5; catholics_spd -= 5; unemployed_spd -= 5; coup_progress += 2 if nsdap_normalized >= 0.3; coup_progress += 2 if nsdap_normalized + dnvp_normalized >= 0.5; sa_strength += 100 if coup_progress >= 7; sh_strength += 100 if coup_progress >= 7
achievement: ausnahmezustand

Fine. President [+ president +] has taken the unprecedented step of canceling these elections. New elections are scheduled for [+ next_election_month : month +] [+ next_election_year +].

Let us hope this does not backfire.

@post_election_1928
on-arrival: {!
if (Q.year < 1929) {
    Q.reichstag_size = 4.91;
} else if (Q.year < 1930) {
    Q.reichstag_size = 5.2;
} else if (Q.year < 1931) {
    Q.reichstag_size = 5.77;
    if (Q.unemployed < 8) Q.reichstag_size -= 0.1;
} else if (Q.year < 1932) {
    Q.reichstag_size = 5.95;
    if (Q.unemployed < 20) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 25) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 30) Q.reichstag_size -= 0.1;
} else if (Q.year < 1933) {
    Q.reichstag_size = 6.08;
    if (Q.unemployed < 20) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 25) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 30) Q.reichstag_size -= 0.1;
} else if (Q.year < 1934) {
    Q.reichstag_size = 5.95;
    if (Q.unemployed < 20) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 25) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 30) Q.reichstag_size -= 0.1;
} else {
    Q.reichstag_size = 5.5;
    if (Q.unemployed < 20) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 25) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 30) Q.reichstag_size -= 0.1;
}

var new_party_sum = 0;
for (var party of Q.parties) {
    Q['old_' + party + '_r'] = Q[party + '_r'];
    Q['old_' + party + '_seats'] = Q[party + '_seats'];
    if (Q.electoral_threshold > 0) {
        if (Q[party + '_votes'] < Q.electoral_threshold || (Q.electoral_threshold > 1 && party == 'other') || Q[party + '_banned'] == 1) {
            Q[party + '_r'] = 0;
        } else {
            Q[party + '_r'] = parseFloat((Q[party+'_votes']).toFixed(1));
        }
        new_party_sum += Q[party + '_r'];
    } else {
        Q[party + '_r'] = parseFloat((Q[party+'_votes']).toFixed(1));
        if (party == 'other') Q[party + '_r'] = Q[party + '_votes'] * 0.3;
        if (Q[party + '_banned'] == 1) Q[party + '_r'] = 0;
        new_party_sum += Q[party + '_r'];
        console.log(new_party_sum)
    }

    Q['change_' + party + '_votes'] = Q[party + '_votes'] - Q['old_' + party + '_votes'];
    var sign2 = Q['change_' + party + '_votes'] > 0 
                    ? '<img src="img/arrowup.png"> ' 
                    : Q['change_' + party + '_votes'] < 0 
                      ? '<img src="img/arrowdown.png"> ' 
                      : '<img src="img/steady.png"> ';
    Q['votes_change_' + party] = sign2 + Math.abs(parseFloat(Q['change_' + party + '_votes'])).toFixed(1);

    Q['old_' + party + '_votes'] = parseFloat((Q[party + '_votes']).toFixed(1));
}

for (var party of Q.parties) {
    if (Q[party + '_r'] > 0) {
        Q[party + '_r'] = Math.round(Q[party + '_r']*1000/new_party_sum)/10;
    }
    Q[party + '_r'] = parseFloat((Q[party+'_r']).toFixed(1));
}

let allocatedSeats = 0;
let remainders = [];

for (var party of Q.parties) {
    let rawSeats = Q[party + '_r'] * Math.round(Q.reichstag_size*100) / 100;
    let seats = Math.floor(rawSeats);
    Q[party + '_seats'] = seats;
    allocatedSeats += seats;
    remainders.push({
        party: party,
        remainder: rawSeats - seats
    });
}

let remainingSeats = Math.round(Q.reichstag_size*100) - allocatedSeats;
remainders.sort((a, b) => b.remainder - a.remainder);
for (let i = 0; i < remainingSeats && i < remainders.length; i++) {
    let partyObj = remainders[i];
    if (!partyObj || !partyObj.party) continue;

    let party = partyObj.party;
    Q[party + '_seats'] += 1;
}

for (var party of Q.parties) {
    Q['change_' + party + '_r'] = Q[party + '_r'] - Q['old_' + party + '_r'];
    var sign = Q['change_' + party + '_r'] > 0 
            ? '<img src="img/arrowup.png"> ' 
            : Q['change_' + party + '_r'] < 0 
                    ? '<img src="img/arrowdown.png"> ' 
                    : '<img src="img/steady.png"> ';
    Q['str_change_' + party] = sign + Math.abs(parseFloat(Q['change_' + party + '_r'])).toFixed(1);

    Q['change_' + party + '_seats'] = Q[party + '_seats'] - Q['old_' + party + '_seats'];
    var sign = Q['change_' + party + '_seats'] > 0 
            ? '<img src="img/arrowup.png"> ' 
            : Q['change_' + party + '_seats'] < 0 
                    ? '<img src="img/arrowdown.png"> ' 
                    : '<img src="img/steady.png"> ';
    Q['str_seats_change_' + party] = sign + Math.abs(Q['change_' + party + '_seats']);
}



Q.bvp_votes = parseFloat((Q.z_votes*0.2).toFixed(1));
if (Q.bvp_votes > 3.6) {
    Q.bvp_votes = 3.6;
}
Q.bvp_r = parseFloat((Q.bvp_votes*1.05).toFixed(1));
if (Q.bvp_r > 3.7) {
    Q.bvp_r = 3.7;
}

Q.z_minus_bvp_votes = parseFloat((Q.z_votes - Q.bvp_votes).toFixed(1));
Q.z_minus_bvp_r = parseFloat((Q.z_r - Q.bvp_r).toFixed(1));
Q.z_minus_bvp_seats = Math.round(Q.z_minus_bvp_r*Q.reichstag_size);
Q.bvp_seats = Math.round(Q.z_seats - Q.z_minus_bvp_seats);


Q.votes_change_bvp = parseFloat((Q.bvp_votes - Q.old_bvp_votes).toFixed(1));
var sign2 = Q.votes_change_bvp > 0 
? '<img src="img/arrowup.png"> ' 
: Q.votes_change_bvp < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.votes_change_bvp = sign2 + Math.abs(Q.votes_change_bvp).toFixed(1);

Q.str_change_bvp = parseFloat((Q.bvp_r - Q.old_bvp_r).toFixed(1));
var sign2 = Q.str_change_bvp > 0 
? '<img src="img/arrowup.png"> ' 
: Q.str_change_bvp < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.str_change_bvp = sign2 + Math.abs(Q.str_change_bvp).toFixed(1);

Q.str_seats_change_bvp = Math.round(Q.bvp_seats - Q.old_bvp_seats);
var sign2 = Q.str_seats_change_bvp > 0 
? '<img src="img/arrowup.png"> ' 
: Q.str_seats_change_bvp < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.str_seats_change_bvp = sign2 + Math.abs(Math.round(Q.str_seats_change_bvp));

Q.str_votes_change_z = parseFloat((Q.z_minus_bvp_votes - Q.old_z_minus_bvp_votes).toFixed(1));
var sign2 = Q.str_votes_change_z > 0 
? '<img src="img/arrowup.png"> ' 
: Q.str_votes_change_z < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.str_votes_change_z = sign2 + Math.abs(Q.str_votes_change_z).toFixed(1);

Q.str_change_z = parseFloat((Q.z_minus_bvp_r - Q.old_z_minus_bvp_r).toFixed(1));
var sign2 = Q.str_change_z > 0
? '<img src="img/arrowup.png"> '
: Q.str_change_z < 0 
  ? '<img src="img/arrowdown.png"> '
  : '<img src="img/steady.png"> ';
Q.str_change_z = sign2 + Math.abs(Q.str_change_z).toFixed(1);

Q.str_seats_change_z = Math.round(Q.z_minus_bvp_seats - Q.old_z_minus_bvp_seats);
var sign2 = Q.str_seats_change_z > 0
? '<img src="img/arrowup.png"> '
: Q.str_seats_change_z < 0 
  ? '<img src="img/arrowdown.png"> '
  : '<img src="img/steady.png"> ';
Q.str_seats_change_z = sign2 + Math.abs(Math.round(Q.str_seats_change_z));

Q.old_bvp_votes = Q.bvp_votes;
Q.old_bvp_r = Q.bvp_r;
Q.old_bvp_seats = Q.bvp_seats;
Q.old_z_minus_bvp_votes = Q.z_minus_bvp_votes;
Q.old_z_minus_bvp_r = Q.z_minus_bvp_r;
Q.old_z_minus_bvp_seats = Q.z_minus_bvp_seats;





Q.largest_party = 'SPD';
if (Q.nsdap_r >= Q.spd_r && Q.nsdap_r >= Q.kpd_r && Q.nsdap_r >= Q.dvp_r) {
    Q.largest_party = 'NSDAP';
}

if (Q.kpd_r >= Q.spd_r && Q.kpd_r >= Q.nsdap_r && Q.kpd_r >= Q.dvp_r) {
    Q.largest_party = 'KPD';
}

if (Q.dvp_r >= Q.spd_r && Q.dvp_r >= Q.nsdap_r && Q.dvp_r >= Q.kpd_r) {
    Q.largest_party = Q.dvp_name;
}

// coalitions
Q.liberal_coalition = parseFloat((Q.dvp_r + Q.ddp_r).toFixed(1));

Q.social_liberal_coalition = parseFloat((Q.spd_r + Q.ddp_r + Q.dvp_r).toFixed(1));

if (Q.ddp_exist) Q.weimar_coalition = parseFloat((Q.spd_r + Q.ddp_r + Q.z_minus_bvp_r + Q.csrp_r).toFixed(1));
if (!Q.ddp_exist) Q.weimar_coalition = parseFloat((Q.spd_r + Q.dvp_r + Q.z_minus_bvp_r + Q.csrp_r).toFixed(1));
if (Q.aspd_exist && Q.aspd_ideology == "Moderate") Q.weimar_coalition = parseFloat((Q.weimar_coalition + Q.aspd_r).toFixed(1));

Q.grand_coalition = parseFloat((Q.spd_r + Q.ddp_r + Q.z_r + Q.dvp_r + Q.csrp_r).toFixed(1));
if (Q.aspd_exist && Q.aspd_ideology == "Moderate") Q.grand_coalition = parseFloat((Q.grand_coalition + Q.aspd_r).toFixed(1));

Q.left_front = parseFloat((Q.kpd_r + Q.sapd_r + Q.spd_r).toFixed(1));

Q.popular_front = parseFloat((Q.kpd_r + Q.sapd_r + Q.spd_r + Q.z_minus_bvp_r).toFixed(1));
if (Q.ddp_exist) Q.popular_front = parseFloat((Q.popular_front + Q.ddp_r).toFixed(1));

Q.bourgeois_coalition = parseFloat((Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r + Q.kvp_r + Q.wp_r + Q.dbp_r + Q.cnblp_r + Q.csvd_r + Q.csrp_r).toFixed(1));
if (Q.aspd_exist && Q.aspd_ideology == "Moderate") Q.bourgeois_coalition = parseFloat((Q.bourgeois_coalition + Q.aspd_r).toFixed(1));

if (Q.kvp_formed) Q.center_right_coalition = parseFloat((Q.z_r + Q.dvp_r + Q.other_r + Q.kvp_r + Q.wp_r + Q.dbp_r + Q.cnblp_r + Q.csvd_r + Q.csrp_r).toFixed(1));
if (!Q.kvp_formed) Q.center_right_coalition = parseFloat((Q.z_r + Q.dvp_r + Q.other_r + Q.dnvp_r + Q.wp_r + Q.dbp_r + Q.cnblp_r + Q.csvd_r + Q.csrp_r).toFixed(1));
if (Q.aspd_exist && Q.aspd_ideology == "Moderate") Q.center_right_coalition = parseFloat((Q.center_right_coalition + Q.aspd_r).toFixed(1));

if (Q.dnvp_ideology == "Moderate") Q.rg_coalition = parseFloat((Q.dvp_r + Q.bvp_r + Q.other_r + Q.dnvp_r + Q.wp_r + Q.dbp_r + Q.cnblp_r + Q.csvd_r + Q.csrp_r).toFixed(1));

Q.neo_weimar_coalition = parseFloat((Q.spd_r + Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r + Q.kvp_r + Q.wp_r + Q.dbp_r + Q.cnblp_r + Q.csvd_r + Q.csrp_r).toFixed(1));
if (Q.dnvp_ideology == "Moderate") Q.neo_weimar_coalition = parseFloat((Q.neo_weimar_coalition + Q.dnvp_r).toFixed(1));
if (Q.aspd_exist && Q.aspd_ideology == "Moderate") Q.neo_weimar_coalition = parseFloat((Q.neo_weimar_coalition + Q.aspd_r).toFixed(1));

if (Q.dnvp_ideology == "Radical") Q.far_right_coalition = parseFloat((Q.dnvp_r + Q.nsdap_r).toFixed(1));
if (Q.dnf_formed) Q.far_right_coalition = parseFloat((Q.dnf_r + Q.nsdap_r).toFixed(1));

if (Q.dnvp_ideology == "Radical") Q.anti_democratic_coalition = parseFloat((Q.kpd_r + Q.nsdap_r + Q.dnvp_r).toFixed(1));
if (Q.dnf_formed) Q.anti_democratic_coalition = parseFloat((Q.kpd_r + Q.nsdap_r + Q.dnf_r).toFixed(1));

// Hitler + Right-wing parties
if (Q.dnvp_ideology == "Radical") Q.hitler_right_coalition = parseFloat((Q.dvp_r + Q.dnvp_r + Q.nsdap_r).toFixed(1));
if (Q.dnf_formed) Q.hitler_right_coalition = parseFloat((Q.dvp_r + Q.dnf_r + Q.nsdap_r).toFixed(1));

Q.leverage = Q.dvp_r;

Q.grand_coalition_failed = 0;

// Reset government and ministers... Based on Brüning's 1930 govt
Q.rg_angry_old = Q.rg_angry;
Q.rg_angry = 0;

Q.spd_in_government = 0;
Q.z_in_government = 0;
Q.ddp_in_government = 0;
Q.dvp_in_government = 0;
Q.dnvp_in_government = 0;
Q.kpd_in_government = 0;
Q.nsdap_in_government = 0;

Q.in_dvp_majority = 0;
Q.in_liberal_coalition = 0;
Q.in_social_liberal_coalition = 0;
Q.in_spd_majority = 0;
Q.in_weimar_coalition = 0;
Q.in_grand_coalition = 0;
Q.in_left_front = 0;
Q.in_popular_front = 0;
Q.in_bourgeois_coalition = 0;
Q.in_center_right_coalition = 0;
Q.in_hindenburg_coalition = 0;
Q.in_new_grand_coalition = 0;
Q.in_minority_government = 0;
Q.in_unity_government = 0;
Q.in_far_right_coalition = 0;
Q.in_hitler_right_coalition = 0;
Q.in_emergency_government = 0;

Q.coalition_dissent = 0;
Q.nsdap_coalition_dissent = 0;
Q.spd_toleration = 0;
Q.toleration_explode = 0;
Q.dvp_toleration = 0;


var election_result = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties) {
    election_result[party] = Q[party + '_r'];
}
Q.election_records.push(election_result);


if (Q.dstp_formed && !Q.dstp_collapse_seen) {
    Q.dstp_election = 1;
}
!}
on-departure: nazi_urgency = 1 if (nazi_urgency == 0 and nsdap_r >= 15)
on-display: {!
data = []
if (Q.kpd_r) {
    data.push({
        "id": "kpd",
        "legend": "KPD",
        "name": "KPD",
        "seats": Math.round(Q.kpd_seats),
    });
}
if (Q.sapd_formed && Q.sapd_r) {
    data.push({
            "id": "sapd",
            "legend": "SAPD",
            "name": "SAPD",
            "seats": Math.round(Q.sapd_seats),
            });
}
if (Q.spd_r) {
    data.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Math.round(Q.spd_seats),
